{
  "name": "bittrade-v3",
  "version": "3.0.0",
  "description": "BitTrade V3 - Quantitative Trading & Research Platform Powered by AssemblyScript & WebAssembly",
  "main": "server/index.ts",
  "scripts": {
    "asbuild:untouched": "asc assembly/index.ts --target debug",
    "asbuild:optimized": "asc assembly/index.ts --target release",
    "asbuild": "npm run asbuild:untouched && npm run asbuild:optimized",
    "start": "ts-node server/index.ts",
    "test:wasm": "ts-node server/wasm_loader.ts",
    "research": "python research/analysis_template.py"
  },
  "keywords": [
    "trading-bot",
    "assemblyscript",
    "webassembly",
    "wasm",
    "crypto",
    "quantitative-trading"
  ],
  "author": "Ilham Pradani <ilhampradani8@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "assemblyscript": "^0.27.29",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@assemblyscript/loader": "^0.27.29",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "ws": "^8.16.0"
  }
}
